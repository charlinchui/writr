# Build from this source checkout: see README.md.
pkgname=writr
pkgver=0.1.0
pkgrel=1
pkgdesc='A minimal native Markdown editor written in C'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('gtk3' 'libpng')
makedepends=('gcc' 'make' 'pkgconf')
source=("writr-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/writr-$pkgver"
  make
}
check() {
  cd "$srcdir/writr-$pkgver"
  make test check-ui
}
package() {
  cd "$srcdir/writr-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
